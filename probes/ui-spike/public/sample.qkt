STRATEGY xau_ema VERSION 1

SYMBOLS
    gold = BACKTEST:XAUUSD EVERY 15m

RULES
    WHEN ema(gold.close, 9) CROSSES ABOVE ema(gold.close, 21)
     AND POSITION.gold = 0
    THEN BUY gold SIZING 0.1 ; LOG "long entry"

    WHEN ema(gold.close, 9) CROSSES BELOW ema(gold.close, 21)
     AND POSITION.gold > 0
    THEN CLOSE gold ; LOG "exit"
