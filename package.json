{
  "name": "qkt-backtester",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @qkt-studio/server dev",
    "dev:web": "pnpm --filter @qkt-studio/web dev",
    "e2e": "node scripts/e2e.mjs",
    "docker:build": "docker build -f docker/Dockerfile -t qkt-backtester:local ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
